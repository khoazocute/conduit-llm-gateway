{
  "openapi": "3.0.3",
  "info": {
    "title": "Conduit — LLM Gateway Portal API",
    "version": "0.1.0",
    "description": "API contract cho backend-gateway (Spring Boot), dựng từ docs/erd.dbml. Phạm vi Must-have là chính; endpoint đánh dấu 'Should-have' (RAG, VNPay) định nghĩa trước cho khớp kiến trúc nhưng chưa bắt buộc triển khai ngay (CLAUDE.md mục 6). Sai số cho phép khi triển khai thực tế: +-3 endpoint so với bản này (thêm/bớt nhỏ khi code, không đổi field đã thống nhất mà không báo lại)."
  },
  "servers": [
    { "url": "http://localhost:8081/api", "description": "backend-gateway local" }
  ],
  "tags": [
    { "name": "Auth", "description": "Owner: Hung (Auth+Agent)" },
    { "name": "Users", "description": "Owner: Hung (Auth+Agent)" },
    { "name": "Agents", "description": "Owner: Hung (Auth+Agent)" },
    { "name": "Admin - Agents", "description": "Owner: Hung (Auth+Agent)" },
    { "name": "Admin - Users", "description": "Owner: Hung (Auth+Agent)" },
    { "name": "Wallet", "description": "Owner: Khoa (Credit+Chat+Payment)" },
    { "name": "Purchases & Payment", "description": "Owner: Khoa (Credit+Chat+Payment)" },
    { "name": "Conversations & Chat", "description": "Owner: Khoa (Credit+Chat+Payment)" },
    { "name": "Admin - API Keys", "description": "Owner: Khoa (Credit+Chat+Payment)" },
    { "name": "Admin - Model Pricing", "description": "Owner: Khoa (Credit+Chat+Payment)" },
    { "name": "Knowledge Base (Should-have)", "description": "RAG mo rong, trien khai sau Must-have" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": { "type": "string", "example": "VALIDATION_ERROR" },
          "message": { "type": "string" },
          "details": { "type": "object", "additionalProperties": true }
        }
      },
      "PageMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer", "example": 0 },
          "size": { "type": "integer", "example": 20 },
          "total_elements": { "type": "integer", "example": 137 },
          "total_pages": { "type": "integer", "example": 7 }
        }
      },

      "UserRole": { "type": "string", "enum": ["admin", "creator", "user"] },
      "UserStatus": { "type": "string", "enum": ["active", "banned"] },

      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "full_name": { "type": "string", "nullable": true },
          "avatar_url": { "type": "string", "nullable": true },
          "role": { "$ref": "#/components/schemas/UserRole" },
          "status": { "$ref": "#/components/schemas/UserStatus" },
          "email_verified": { "type": "boolean" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },

      "RegisterRequest": {
        "type": "object",
        "required": ["email", "password", "full_name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 8 },
          "full_name": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string", "description": "Chi dung khi refresh token KHONG duoc gui qua HttpOnly cookie (vd: mobile client). Web client uu tien cookie, khong can field nay." }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "expires_in": { "type": "integer", "example": 1800, "description": "giay, 15-30 phut theo CLAUDE.md muc 7" },
          "user": { "$ref": "#/components/schemas/User" }
        },
        "description": "refresh_token duoc set qua Set-Cookie HttpOnly, khong tra ve trong body."
      },

      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "full_name": { "type": "string" },
          "avatar_url": { "type": "string" }
        }
      },

      "AgentType": { "type": "string", "enum": ["text"] },
      "AgentStatus": { "type": "string", "enum": ["draft", "pending", "approved", "rejected", "published", "unpublished"] },

      "Agent": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "creator_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "introduction": { "type": "string", "nullable": true },
          "agent_type": { "$ref": "#/components/schemas/AgentType" },
          "price_vnd": { "type": "integer", "minimum": 0 },
          "default_credit_granted": { "type": "integer", "minimum": 0 },
          "status": { "$ref": "#/components/schemas/AgentStatus" },
          "reject_reason": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateAgentRequest": {
        "type": "object",
        "required": ["title", "price_vnd", "default_credit_granted"],
        "properties": {
          "title": { "type": "string" },
          "introduction": { "type": "string" },
          "agent_type": { "$ref": "#/components/schemas/AgentType" },
          "price_vnd": { "type": "integer", "minimum": 0 },
          "default_credit_granted": { "type": "integer", "minimum": 0 }
        }
      },
      "UpdateAgentRequest": {
        "type": "object",
        "description": "Chi cho phep sua khi agent dang o status draft hoac rejected (ABAC: kiem tra creator_id khop voi user hien tai).",
        "properties": {
          "title": { "type": "string" },
          "introduction": { "type": "string" },
          "price_vnd": { "type": "integer", "minimum": 0 },
          "default_credit_granted": { "type": "integer", "minimum": 0 }
        }
      },
      "RejectAgentRequest": {
        "type": "object",
        "required": ["reject_reason"],
        "properties": {
          "reject_reason": { "type": "string" }
        }
      },
      "AgentListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Agent" } },
          "page": { "$ref": "#/components/schemas/PageMeta" }
        }
      },

      "UpdateUserStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/components/schemas/UserStatus" }
        }
      },

      "CreditWallet": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "balance": { "type": "integer", "description": "don vi: credit noi bo, khong phai token" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreditTxType": { "type": "string", "enum": ["purchase_grant", "usage_deduct", "topup", "refund_deduct"] },
      "CreditTransaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "wallet_id": { "type": "string", "format": "uuid" },
          "type": { "$ref": "#/components/schemas/CreditTxType" },
          "amount": { "type": "integer", "description": "duong = cong, am = tru" },
          "related_message_id": { "type": "string", "format": "uuid", "nullable": true },
          "related_purchase_id": { "type": "string", "format": "uuid", "nullable": true },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreditTransactionListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/CreditTransaction" } },
          "page": { "$ref": "#/components/schemas/PageMeta" }
        }
      },

      "PaymentMethod": { "type": "string", "enum": ["vnpay", "mock"] },
      "PaymentStatus": { "type": "string", "enum": ["pending", "paid", "failed", "refunded"] },

      "CreatePurchaseRequest": {
        "type": "object",
        "required": ["payment_method"],
        "properties": {
          "payment_method": { "$ref": "#/components/schemas/PaymentMethod" }
        }
      },
      "AgentPurchase": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "agent_id": { "type": "string", "format": "uuid" },
          "amount_vnd": { "type": "integer" },
          "default_credit_granted": { "type": "integer" },
          "payment_method": { "$ref": "#/components/schemas/PaymentMethod" },
          "payment_status": { "$ref": "#/components/schemas/PaymentStatus" },
          "transaction_ref": { "type": "string", "description": "unique, dung cho idempotency" },
          "paid_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePurchaseResponse": {
        "type": "object",
        "properties": {
          "purchase": { "$ref": "#/components/schemas/AgentPurchase" },
          "redirect_url": { "type": "string", "nullable": true, "description": "URL redirect toi VNPay sandbox; null khi payment_method=mock (client tu goi webhook mock de mo phong)." }
        }
      },

      "WebhookResult": { "type": "string", "enum": ["accepted", "duplicate", "invalid_signature"] },
      "MockWebhookRequest": {
        "type": "object",
        "required": ["transaction_ref", "result"],
        "properties": {
          "transaction_ref": { "type": "string" },
          "result": { "type": "string", "enum": ["success", "failed"] }
        }
      },
      "VnpayWebhookRequest": {
        "type": "object",
        "description": "Should-have. Field theo dung format callback that cua VNPay sandbox (vnp_TxnRef, vnp_ResponseCode, vnp_SecureHash, ...) - se chuan hoa lai khi trien khai that.",
        "properties": {
          "vnp_TxnRef": { "type": "string" },
          "vnp_ResponseCode": { "type": "string" },
          "vnp_Amount": { "type": "string" },
          "vnp_SecureHash": { "type": "string" }
        }
      },
      "WebhookResponse": {
        "type": "object",
        "properties": {
          "result": { "$ref": "#/components/schemas/WebhookResult" }
        }
      },

      "Conversation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "agent_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateConversationRequest": {
        "type": "object",
        "required": ["agent_id"],
        "properties": {
          "agent_id": { "type": "string", "format": "uuid" }
        }
      },
      "ConversationListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Conversation" } },
          "page": { "$ref": "#/components/schemas/PageMeta" }
        }
      },

      "MessageRole": { "type": "string", "enum": ["user", "assistant"] },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "conversation_id": { "type": "string", "format": "uuid" },
          "role": { "$ref": "#/components/schemas/MessageRole" },
          "content": { "type": "string" },
          "credit_charged": { "type": "integer", "nullable": true, "description": "null neu luot goi loi/retry khong tinh phi (CLAUDE.md muc 5)" },
          "model_used": { "type": "string", "nullable": true },
          "latency_ms": { "type": "integer", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "MessageListResponse": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } },
          "page": { "$ref": "#/components/schemas/PageMeta" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "required": ["content"],
        "properties": {
          "content": { "type": "string" }
        }
      },
      "MessageStreamChunk": {
        "type": "object",
        "description": "1 event SSE (Content-Type: text/event-stream), 'event: chunk' lap lai roi ket bang 'event: done'.",
        "properties": {
          "delta": { "type": "string", "nullable": true, "description": "co o event 'chunk'" },
          "message": {
            "description": "co o event 'done', message hoan chinh da luu",
            "allOf": [{ "$ref": "#/components/schemas/Message" }]
          }
        }
      },

      "LlmProvider": { "type": "string", "enum": ["openai", "anthropic", "google"] },
      "ApiKeyStatus": { "type": "string", "enum": ["active", "rate_limited", "disabled"] },
      "ApiKey": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "provider": { "$ref": "#/components/schemas/LlmProvider" },
          "status": { "$ref": "#/components/schemas/ApiKeyStatus" },
          "priority": { "type": "integer" },
          "last_used_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        },
        "description": "key_encrypted KHONG bao gio tra ve qua API (CLAUDE.md muc 7)."
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": ["provider", "raw_key"],
        "properties": {
          "provider": { "$ref": "#/components/schemas/LlmProvider" },
          "raw_key": { "type": "string", "description": "key that, server ma hoa AES-GCM truoc khi luu, khong bao gio log ra" },
          "priority": { "type": "integer", "default": 0 }
        }
      },
      "UpdateApiKeyRequest": {
        "type": "object",
        "properties": {
          "status": { "$ref": "#/components/schemas/ApiKeyStatus" },
          "priority": { "type": "integer" }
        }
      },

      "UnitType": { "type": "string", "enum": ["token_input", "token_output", "image_generation"] },
      "ModelPricing": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "provider": { "$ref": "#/components/schemas/LlmProvider" },
          "model": { "type": "string" },
          "unit_type": { "$ref": "#/components/schemas/UnitType" },
          "price_usd_per_unit": { "type": "number", "format": "double" },
          "credit_markup_multiplier": { "type": "number", "format": "double", "default": 1.5 },
          "effective_from": { "type": "string", "format": "date-time" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CreateModelPricingRequest": {
        "type": "object",
        "required": ["provider", "model", "unit_type", "price_usd_per_unit", "effective_from"],
        "properties": {
          "provider": { "$ref": "#/components/schemas/LlmProvider" },
          "model": { "type": "string" },
          "unit_type": { "$ref": "#/components/schemas/UnitType" },
          "price_usd_per_unit": { "type": "number", "format": "double" },
          "credit_markup_multiplier": { "type": "number", "format": "double", "default": 1.5 },
          "effective_from": { "type": "string", "format": "date-time" }
        }
      },
      "UpdateModelPricingRequest": {
        "type": "object",
        "description": "Tao ban ghi moi voi effective_from moi thay vi sua gia cu (giu lich su tang gia) - endpoint nay chi cho phep sua truoc effective_from (chua ap dung).",
        "properties": {
          "price_usd_per_unit": { "type": "number", "format": "double" },
          "credit_markup_multiplier": { "type": "number", "format": "double" },
          "effective_from": { "type": "string", "format": "date-time" }
        }
      },

      "KbStatus": { "type": "string", "enum": ["processing", "ready", "failed"] },
      "KnowledgeBase": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "agent_id": { "type": "string", "format": "uuid" },
          "file_name": { "type": "string" },
          "file_url": { "type": "string" },
          "status": { "$ref": "#/components/schemas/KbStatus" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Request khong hop le", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unauthorized": { "description": "Thieu hoac sai JWT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Forbidden": { "description": "Khong du quyen (role hoac khong phai chu so huu - ABAC)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Khong tim thay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Conflict": { "description": "Xung dot trang thai (vd: khong du credit, trang thai khong hop le de chuyen doi)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Dang ky tai khoan (role mac dinh: user)",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } } } },
        "responses": {
          "201": { "description": "Tao thanh cong, tu dong tao credit_wallets voi balance=0", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Dang nhap, tra access token + set refresh token qua HttpOnly cookie",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Cap access token moi tu refresh token (cookie hoac body)",
        "requestBody": { "required": false, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Thu hoi refresh token, xoa cookie",
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "No Content" } }
      }
    },

    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Thong tin user dang dang nhap",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Cap nhat ho so ban than",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } } } },
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },

    "/agents": {
      "get": {
        "tags": ["Agents"],
        "summary": "Tim kiem/liet ke agent da published (sang agent, khong can dang nhap)",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "tu khoa tim theo title" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentListResponse" } } } }
        }
      },
      "post": {
        "tags": ["Agents"],
        "summary": "Creator tao agent moi (status=draft)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateAgentRequest" } } } },
        "responses": {
          "201": { "description": "Created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Agent" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "description": "Chi role creator/admin duoc tao agent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/agents/mine": {
      "get": {
        "tags": ["Agents"],
        "summary": "Agent cua creator dang dang nhap (moi status, ke ca draft/rejected)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/AgentStatus" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentListResponse" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/agents/{agentId}": {
      "get": {
        "tags": ["Agents"],
        "summary": "Chi tiet 1 agent",
        "parameters": [{ "name": "agentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Agent" } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["Agents"],
        "summary": "Creator sua agent cua chinh minh (ABAC: creator_id phai khop)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "agentId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],

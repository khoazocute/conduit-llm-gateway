# Copy to .env and fill in real values. .env is gitignored.

OPENAI_API_KEY=sk-changeme
ANTHROPIC_API_KEY=sk-ant-changeme
GEMINI_API_KEY=changeme

# LiteLLM proxy master key (used to authenticate calls to the LiteLLM gateway itself)
LITELLM_MASTER_KEY=sk-litellm-changeme

# JWT (backend-gateway, Auth+Agent vertical)
JWT_SECRET=changeme-use-a-long-random-256-bit-secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=20
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=7
